{
  "start": "collect",
  "types": {
    "Request": {
      "type": "object",
      "required": ["branch"],
      "properties": {"branch": {"type": "string"}}
    },
    "Change": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {"id": {"type": "string"}, "path": {"type": "string"}}
    },
    "Report": {
      "type": "object",
      "required": ["change", "findings"],
      "properties": {
        "change": {"$ref": "#/Change"},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "nodes": {
    "collect": {
      "command": "nodes/collect/run.sh",
      "in": {"$ref": "#/Request"},
      "out": {"$ref": "#/Change"},
      "then": "is-empty"
    },
    "is-empty": {
      "decide": "nodes/is-empty/run.sh",
      "in": {"$ref": "#/Change"},
      "then": "discard",
      "else": "inspect"
    },
    "inspect": {
      "command": "nodes/inspect/run.sh",
      "in": {"$ref": "#/Change"},
      "out": {"$ref": "#/Report"},
      "then": "verdict"
    },
    "verdict": {
      "decide": "nodes/verdict/run.sh",
      "in": {"$ref": "#/Report"},
      "then": {
        "accepted": ["publish", "notify"],
        "returned": "fix"
      }
    },
    "fix": {
      "command": "nodes/fix/run.sh",
      "in": {"$ref": "#/Report"},
      "out": {"$ref": "#/Change"},
      "then": "inspect"
    },
    "publish": {
      "command": "nodes/publish/run.sh",
      "in": {"$ref": "#/Report"}
    },
    "discard": {
      "command": "nodes/discard/run.sh",
      "in": {"$ref": "#/Change"}
    },
    "notify": {
      "command": "nodes/notify/run.sh",
      "in": {"$ref": "#/Report"}
    }
  }
}
