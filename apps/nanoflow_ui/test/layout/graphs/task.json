{
  "start": "admit",
  "nodes": {
    "admit": {
      "decide": "nodes/admit/run.sh",
      "then": {"fresh": "coder", "review": "reviewer", "human": "human-review"},
      "else": []
    },
    "coder": {"command": "nodes/coder/run.sh", "then": "coder-status"},
    "coder-status": {
      "decide": "nodes/coder-status/run.sh",
      "then": {"done": "checks", "go-on": "coder", "post": "coder"},
      "else": []
    },
    "checks": {"command": "nodes/checks/run.sh", "then": "checks-result"},
    "checks-result": {
      "decide": "nodes/checks-result/run.sh",
      "then": {"pass": "reviewer", "repair": "coder"},
      "else": []
    },
    "reviewer": {"command": "nodes/reviewer/run.sh", "then": "review-verdict"},
    "review-verdict": {
      "decide": "nodes/review-verdict/run.sh",
      "then": {"pass": "human-review", "fail": "coder", "again": "reviewer"},
      "else": []
    },
    "human-review": {
      "command": "nodes/human-review/wait.sh",
      "then": "human-answer"
    },
    "human-answer": {
      "decide": "nodes/human-answer/run.sh",
      "then": {"accept": "accept", "changes": "coder"},
      "else": []
    },
    "accept": {"command": "nodes/accept/run.sh"}
  }
}
