{
  "start": "release",
  "nodes": {
    "release": {
      "decide": "nodes/release/run.sh",
      "then": {
        "go": ["build-mac", "build-linux", "build-windows", "notes"],
        "hold": "wait"
      }
    },
    "build-mac": {"command": "nodes/build-mac/run.sh", "then": "sign"},
    "build-linux": {"command": "nodes/build-linux/run.sh", "then": "upload"},
    "build-windows": {"command": "nodes/build-windows/run.sh", "then": "sign"},
    "notes": {"command": "nodes/notes/run.sh", "then": ["upload", "announce", "archive"]},
    "sign": {"command": "nodes/sign/run.sh", "then": "upload"},
    "upload": {"command": "nodes/upload/run.sh"},
    "announce": {"command": "nodes/announce/run.sh"},
    "archive": {"command": "nodes/archive/run.sh"},
    "wait": {"command": "nodes/wait/run.sh"}
  }
}
