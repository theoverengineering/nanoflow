{
  "start": ["watch-mail", "watch-chat", "nightly"],
  "nodes": {
    "watch-mail": {"command": "nodes/watch-mail/run.sh", "then": "classify"},
    "watch-chat": {"command": "nodes/watch-chat/run.sh", "then": "classify"},
    "nightly": {"command": "nodes/nightly/run.sh", "then": "digest"},
    "classify": {
      "decide": "nodes/classify/run.sh",
      "then": {"urgent": "page", "normal": "digest"},
      "else": []
    },
    "page": {"command": "nodes/page/run.sh"},
    "digest": {"command": "nodes/digest/run.sh"}
  }
}
