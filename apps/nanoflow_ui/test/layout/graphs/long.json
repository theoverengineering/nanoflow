{
  "start": "plan",
  "nodes": {
    "plan": {
      "decide": "nodes/plan/run.sh",
      "then": {"full": "lint", "quick": "test", "docs": "publish", "none": "done"}
    },
    "lint": {"command": "nodes/lint/run.sh", "then": "compile"},
    "compile": {"command": "nodes/compile/run.sh", "then": "test"},
    "test": {
      "decide": "nodes/test/run.sh",
      "then": {"green": "package", "flaky": "done"}
    },
    "package": {"command": "nodes/package/run.sh", "then": "publish"},
    "publish": {"command": "nodes/publish/run.sh", "then": "done"},
    "done": {"command": "nodes/done/run.sh"}
  }
}
